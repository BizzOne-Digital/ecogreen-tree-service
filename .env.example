# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ecogreen

# Long random string used to sign admin sessions: openssl rand -hex 32
AUTH_SECRET=

# Public site URL, used for the sitemap, canonical URLs and OpenGraph
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Admin login. Generate the hash with: npm run admin:hash -- "your-password"
ADMIN_EMAIL=
# In a local .env file every $ must be escaped as \$ (the script prints both forms).
ADMIN_PASSWORD_HASH=
